# Python: служебные файлы и окружение (создаются автоматически)
__pycache__/
*.pyc
*.egg-info/
.venv/

# секреты: ключи, адреса и имена моделей только в .env, никогда в git
.env
.env.*
!.env.example

# логи: большие и меняются при каждом запуске
*.log
*.err
*.out

# результаты прогонов хранятся вне git (бэкап отдельно)
runs/

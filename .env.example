# Пример настроек. Скопируй в .env (в корне проекта, рядом с этим файлом) и впиши значения.
# Сам .env в git не попадает (см. .gitignore). Комментарии пиши только на отдельных строках.

# Ключ платформы BitGN (обязательно)
BITGN_API_KEY=

# Провайдеры моделей: нужен тот, что указан в плане прогона ("provider")
OPENROUTER_API_KEY=
EDENAI_API_KEY=
QWEN_API_KEY=
QWEN_BASE_URL=
# имя модели на сервере; в планах и логах вместо него псевдоним "qwen"
QWEN_MODEL=

# Необязательно, задаются переменными окружения, НЕ в этом файле:
# BITGN_RUNS      - папка результатов (по умолчанию runs/ в корне проекта)
# BITGN_AGENT_PY  - Python агента (по умолчанию agent/.venv)
